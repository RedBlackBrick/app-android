<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Réseau -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Requis pour détecter un tunnel VPN système actif (app WireGuard officielle,
         OpenVPN, etc.) via ConnectivityManager.getNetworkCapabilities. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- VPN -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Caméra QR pairing -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Biométrie -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Notifications Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- WorkManager reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Visibilité des paquets (Android 11+) : l'écran de connexion propose « Ouvrir WireGuard »
         seulement si l'app WireGuard officielle est installée (getLaunchIntentForPackage). -->
    <queries>
        <package android:name="com.wireguard.android" />
    </queries>

    <!-- android:allowBackup="false" disables cloud backup, device-to-device transfer and adb
         backup entirely, on every API level down to minSdk 28 — tokens, WireGuard keys and the
         Room db never leave the device via any backup path. android:dataExtractionRules is kept
         as defense-in-depth documentation (excludes everything under domain="root", i.e. also
         the EncryptedDataStore prefs, Room db and DataStore files) should allowBackup ever be
         re-enabled; lint's suggestion to also declare android:fullBackupContent (pre-12 API path)
         is moot with allowBackup=false and is suppressed below. -->
    <application
        android:name=".TradingApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:ignore="DataExtractionRules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TradingPlatform">

        <!-- Désactive le WorkManagerInitializer par défaut (androidx.startup) pour laisser
             TradingApplication fournir sa Configuration via Configuration.Provider avec
             le HiltWorkerFactory. Sans ça, WorkManager s'initialise avant que Hilt injecte
             les champs de l'Application → les workers @HiltWorker ne peuvent pas être
             instanciés. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>


        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WireGuard notification service (foreground, "VPN connecté").
             Not a VpnService: the tunnel is held by GoBackend$VpnService, declared with
             BIND_VPN_SERVICE + android.net.VpnService filter by the wireguard tunnel AAR. -->
        <service
            android:name=".vpn.WireGuardVpnService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="VPN tunnel WireGuard — toutes les requêtes API passent par ce tunnel" />
        </service>

        <!-- FCM Service -->
        <service
            android:name=".fcm.TradingFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Widgets Glance receivers -->
        <receiver
            android:name=".widget.PnlWidgetReceiver"
            android:exported="false"
            android:label="P&amp;L Widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pnl_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.PositionsWidgetReceiver"
            android:exported="false"
            android:label="Positions Widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/positions_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.AlertsWidgetReceiver"
            android:exported="false"
            android:label="Alerts Widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/alerts_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.SystemStatusWidgetReceiver"
            android:exported="false"
            android:label="System Status Widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/system_status_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.QuoteWidgetReceiver"
            android:exported="false"
            android:label="Quote Widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quote_widget_info" />
        </receiver>

        <!-- QuoteWidget configuration activity -->
        <activity
            android:name=".widget.QuoteWidgetConfigureActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- PnlWidget configuration activity (période jour/semaine/mois par instance) -->
        <activity
            android:name=".widget.PnlWidgetConfigureActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

    </application>
</manifest>
