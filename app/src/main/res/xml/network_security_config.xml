<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Default: block cleartext (HTTPS only for VPS traffic). -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <!-- Caddy internal Root CA (trading-platform2 VPS at 10.42.0.1).
                 Required because the VPS uses `tls internal` (not a public CA).
                 The SPKI SHA-256 is additionally pinned by OkHttp
                 CertificatePinner, so trust here is already narrowed. -->
            <certificates src="@raw/caddy_root_ca" />
        </trust-anchors>
    </base-config>

    <!-- No cleartext exception for the Radxa LAN pairing server: it is HTTPS-only.
         `di/NetworkModule.kt` provideLanOkHttpClient() talks to it through a dedicated
         OkHttpClient whose `lanOnlyHttpsGuard()` interceptor rejects any request that is
         not HTTPS or not RFC-1918 before the socket is even opened, and LanTrustManager
         validates the Radxa's self-signed cert. The `"http://localhost/"` Retrofit base
         URL for that client (`@Named("lan") provideLanRetrofit`) is an unused fallback —
         every real call supplies a full HTTPS `@Url`. There is therefore no cleartext
         traffic anywhere in the app, and no LAN IP domain-config carve-out is needed here.

         Defense-in-depth layers for the LAN pairing call:
         1. lanOnlyHttpsGuard() rejects non-HTTPS / non-RFC-1918 targets
         2. VpnRequiredInterceptor blocks the call when the tunnel is down
         3. isLocalNetwork() validates RFC-1918 in PairingRepositoryImpl before the call
         4. crypto_box_seal() encrypts session_pin/local_token in the request body -->
</network-security-config>
